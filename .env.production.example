# Public production identity
APP_ENV=production
NEXT_PUBLIC_SITE_URL=https://www.writex.co.in
NEXT_PUBLIC_WHATSAPP_NUMBER=918100977068
NEXT_PUBLIC_DEMO_LOGIN_ENABLED=false
REPRESENTATIVE_DIRECTORY_MODE=unavailable
REPRESENTATIVE_DIRECTORY_HMAC_SECRET=
REPRESENTATIVE_DIRECTORY_API_BASE_URL=
REPRESENTATIVE_DIRECTORY_API_KEY=
REPRESENTATIVE_DIRECTORY_TIMEOUT_MS=5000
TRUST_REPRESENTATIVE_PROVIDER=unavailable
TRUST_INVOICE_PROVIDER=unavailable
TRUST_PAYMENT_PROVIDER=unavailable
TRUST_ENQUIRY_PROVIDER=unavailable
TRUST_REPORTING_ENABLED=false
TRUST_REPORT_MAX_FILE_MB=10
TRUST_REPORT_NOTIFICATION_EMAILS=business@writex.co.in,info@writex.co.in

# PostgreSQL is local to the Lightsail instance and must never be publicly exposed.
DATABASE_URL=postgresql://writex_co_in_app:REPLACE_WITH_A_STRONG_PASSWORD@127.0.0.1:5432/writex_co_in
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
HEALTHCHECK_REQUIRE_DATABASE=true

# Authentication and scheduled-job secrets (generate unique random values).
AUTH_COOKIE_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
CLIENT_ACCESS_CODE_PEPPER=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JOB_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
CLIENT_SESSION_COOKIE_NAME=__Host-writex_client_session
CLIENT_SESSION_EXPIRY_SECONDS=3600
CLIENT_SESSION_IDLE_EXPIRY_SECONDS=1800
CLIENT_LOGIN_MAX_ATTEMPTS=6
CLIENT_LOGIN_LOCK_MINUTES=15
CLIENT_PORTAL_TEST_ACCESS_ENABLED=false
CLIENT_AUTH_PROVIDER=unavailable
CLIENT_BILLING_PROVIDER=unavailable
CLIENT_PROJECT_PROVIDER=unavailable
CLIENT_DELIVERABLES_PROVIDER=unavailable

# Production safety switches
DEMO_LOGIN_ENABLED=false
DEMO_SESSION_EXPIRY_SECONDS=3600
ALLOW_INSECURE_DEMO_COOKIE=false
INTEGRATION_MODE=disabled
PAYMENT_LOCAL_STORAGE_ENABLED=false
NEXT_PUBLIC_PAYMENT_PORTAL_ENABLED=false

# Amazon SES SMTP in Asia Pacific (Mumbai). Keep credentials server-side only.
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_REJECT_UNAUTHORIZED=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=WriteX
SMTP_FROM_EMAIL=info@writex.co.in
SMTP_REPLY_TO=info@writex.co.in
SES_CONFIGURATION_SET=writex-transactional
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000
QUOTE_NOTIFICATION_EMAIL=info@writex.co.in
CONTACT_NOTIFICATION_EMAIL=info@writex.co.in
SUPPORT_EMAIL=info@writex.co.in
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional AWS S3 upload integration. Configure the complete group or leave it blank.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Optional future integrations. Keep disabled until production credentials are approved.
LTS_API_BASE_URL=
LTS_REPRESENTATIVES_URL=
LTS_REPRESENTATIVES_API_KEY=
LTS_HEALTH_URL=
LTS_HEALTH_API_KEY=
LTS_API_HEADER_NAME=x-writex-api-key
WRITEX_REPRESENTATIVE_DISPLAY_NAMES=
WRITEX_INTERNAL_APP_URL=http://127.0.0.1:3002
REPRESENTATIVE_SYNC_SCHEDULE_ENABLED=false
PMT_API_BASE_URL=
PMT_API_KEY=

# Optional origin policy
ALLOWED_ORIGINS=https://www.writex.co.in,https://writex.co.in
# Smart Hiring connected-candidate controls (server-only)
HIRING_RISK_HMAC_SECRET=
# 32 random bytes encoded as base64; encrypts candidate relationship disclosures
HIRING_REVIEW_ENCRYPTION_KEY=
SMART_HIRING_ENABLED=false
HIRING_APPLICATIONS_ENABLED=false
HIRING_ASSESSMENTS_ENABLED=false
HIRING_ANTI_CHEAT_ENABLED=false
HIRING_ADMIN_ENABLED=false
HIRING_CONNECTED_CANDIDATES_ENABLED=false
HIRING_HRMS_PROVIDER=unavailable
HIRING_TRUST_PUBLISHING_ENABLED=false
HIRING_AADHAAR_PROVIDER=unavailable
HIRING_BACKGROUND_PROVIDER=manual
HIRING_MALWARE_PROVIDER=unavailable
HIRING_NOTIFICATION_EMAIL=business@writex.co.in
HIRING_ASSESSMENT_COPY_WARNING_THRESHOLD=3
HIRING_ASSESSMENT_FOCUS_WARNING_THRESHOLD=4
HIRING_CANDIDATE_FILE_RETENTION_DAYS=180
WEBSITE_EXPERIENCE_ADMIN_CAN_ACTIVATE=false

# Website backend to Sales Academy internal API. The matching key is configured in the Academy only.
ACADEMY_INTERNAL_BASE_URL=http://127.0.0.1:3004
ACADEMY_INTERNAL_SERVICE_ID=writex-website
ACADEMY_INTERNAL_KEY_ID=
ACADEMY_INTERNAL_SERVICE_SECRET=
ACADEMY_INTERNAL_TIMEOUT_MS=8000
